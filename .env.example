# Isi key hanya pada file .env di server. Jangan gunakan awalan VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
PORT=3000
HOST=127.0.0.1
# Wajib untuk mengakses aplikasi dari luar localhost. Buat password panjang.
APP_PASSWORD=
# URL publik jika memakai reverse proxy HTTPS.
PUBLIC_ORIGIN=
DATA_DIR=./data
